# Secrets the Cloudflare Worker reads. NAMES ONLY: never put real values in this file or in git.
#
# Production: Cloudflare dashboard > Workers & Pages > ema-tracker > Settings > Variables and secrets >
#             Add > Type "Secret" (not "Text": plain variables are wiped by the next deploy from GitHub).
#             Or from a terminal: npx wrangler secret put TELEGRAM_BOT_TOKEN
# Local dev:  copy this file to .dev.vars (git-ignored) and fill in the values.
#
# Non-secret settings (PUBLIC_BASE_URL, RUNTIME_ROLE, LOG_LEVEL) live in wrangler.jsonc under "vars".

# From @BotFather. Lets the bot send and receive messages.
TELEGRAM_BOT_TOKEN=

# Your chat with the bot (a private chat ID equals your Telegram user ID).
TELEGRAM_CHAT_ID=

# Optional. Comma-separated Telegram user IDs allowed to change settings. Defaults to TELEGRAM_CHAT_ID.
TELEGRAM_ADMIN_USER_IDS=

# Needed from slice S5 (Telegram buttons and mini app). 1-256 characters: letters, digits, _ or -.
TELEGRAM_WEBHOOK_SECRET=

# Your Healthchecks.io ping URL (treat it as a secret: anyone with it can fake "alive").
HEALTHCHECK_PING_URL=
