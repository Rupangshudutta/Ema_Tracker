# Docker spare settings. Copy this file to .env.docker (git-ignored) and fill in the values.
# Never commit .env.docker: it holds the bot token.

# Same bot token and chat as on Cloudflare (from @BotFather and your private chat with the bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only for a group chat: comma-separated Telegram user IDs allowed to change settings.
TELEGRAM_ADMIN_USER_IDS=
# Only if you also set it on Cloudflare (both engines must use the same value).
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare's address: the spare copies settings from it, checks in, and hands alerts back to it.
PUBLIC_BASE_URL=https://ema-tracker.rupangshudutta.workers.dev

# Optional: the same Healthchecks.io ping URL as on Cloudflare (only the active engine pings).
HEALTHCHECK_PING_URL=

# RUNTIME_ROLE is set by the compose file: standby by default, active for an emergency takeover (see docs/RUNBOOK.md).
