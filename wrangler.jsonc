{
  // Cloudflare Worker for EMA Tracker v2. Deployed by Cloudflare Workers Builds on pushes to main.
  // Secrets are never set here; add them in the dashboard (Settings > Variables and Secrets) or with `wrangler secret put`.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ema-tracker",
  "main": "runtimes/cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // Wakes the Worker at the start of every minute (UTC). Candle-close work runs inside the Tracker Durable Object.
  "triggers": { "crons": ["* * * * *"] },

  // One always-on Tracker object ("the desk worker") holds the live Delta feed and its own SQLite notebook.
  "durable_objects": { "bindings": [{ "name": "TRACKER", "class_name": "Tracker" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tracker"] }],

  // Non-secret settings live here because a deploy wipes plain variables added in the dashboard (secrets survive).
  // Secrets, by name only, are listed in .dev.vars.example.
  "vars": {
    "PUBLIC_BASE_URL": "https://ema-tracker.rupangshudutta.workers.dev",
    "RUNTIME_ROLE": "active",
    "LOG_LEVEL": "info"
  },

  // Exposes the deployed version id, so restarts in the probe report can be tied to deploys.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Type check and tests run before every deploy; a failure stops the deploy.
  "build": { "command": "npm run check", "watch_dir": ["core", "runtimes"] }
}
